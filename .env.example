# Copia este archivo como .env y cambia los valores.

# Quiénes usan la app, separados por coma: Nombre:PIN. El PIN tiene de 4 a 8 números.
USERS="José:1234,Esposa:5678"

# Puerto donde escucha la app.
PORT=3000

# Pon 1 si la app está detrás de nginx (Ploi, Forge, etc.).
TRUST_PROXY=0

# Clave de Claude para leer las fotos de las facturas.
# Sin clave la app funciona igual, pero el total se escribe a mano.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Moneda e idioma de los montos.
CURRENCY=DOP
LOCALE=es-DO

# Carpeta donde se guardan la base de datos y las fotos.
DATA_DIR=./data
